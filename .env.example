NODE_ENV=development
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
API_PORT=8000
AGENT_PORT=8100
MEDIA_WORKER_PORT=8102
LTX_WORKER_BASE_URL=http://localhost:8101
COMFYUI_BASE_URL=http://localhost:8188
DATABASE_URL=file:./dev.db
STORAGE_ROOT=./storage
REDIS_URL=redis://localhost:6379
ENABLE_DEV_BYOK=false
HF_ENABLED=false
HF_TOKEN=
FAL_ENABLED=false
FAL_KEY=
FAL_MAX_COST_PER_JOB_USD=0
MUAPI_ENABLED=false
MUAPI_KEY=
COMFYUI_ENABLED=false
LTX_ENABLED=false
LOG_LEVEL=info

# ──── FREE LLM INFERENCE — NVIDIA NIM PROXY ────────────────────────────────
# All text generation (prompts, scripts, character passports, lyrics) routes
# through the free NVIDIA NIM proxy — $0 cost, 40 req/min limit
# This is the primary inference configuration for More-of-Less Studio
OPENAI_API_KEY=dummy
OPENAI_BASE_URL=http://31.220.58.212:8082
OPENAI_MODEL=moonshotai/kimi-k2-thinking
NIM_PROXY_HEALTH_CHECK_ENABLED=true
NIM_PROXY_HEALTH_CHECK_INTERVAL=300000

# ──── COMFYUI (VIDEO RENDERING) ─────────────────────────────────────────
# For local self-hosted deployment; set to your VPS/local ComfyUI instance
COMFYUI_URL=http://31.220.58.212:8188

# ──── LTX WORKER (VIDEO GENERATION) ──────────────────────────────────────
# For AI video frame generation; self-host with ComfyUI or use managed service
LTX_WORKER_URL=http://31.220.58.212:8101

# ──── DISABLE PAID PROVIDERS (OPTIONAL) ──────────────────────────────────
# Uncomment to enforce free-tier mode and prevent accidental charges
# FAL_KEY=disabled
# MUAPI_KEY=disabled
# HUGGINGFACE_TOKEN=disabled
