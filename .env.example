# Cynthia Studio / More-of-Less — Environment Variables
# Copy to .env.local for local dev.
# NEVER commit real secrets to git.

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
API_PORT=8000

# Brand (white-label)
NEXT_PUBLIC_BRAND_NAME=Cynthia Studio
NEXT_PUBLIC_BRAND_TAGLINE=AI Creative Studio for LatAm
NEXT_PUBLIC_BRAND_ACCENT=violet

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# Optional: Google OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Local dev: skip real session check (NEVER set true in production)
LOCAL_DEV_AUTH=true
DEV_USER_ID=dev-user-seed
DEV_ORG_ID=dev-org-seed
DEV_WORKSPACE_ID=dev-workspace-seed

# ─── Database ─────────────────────────────────────────────────────────────────
# Postgres for production:
# DATABASE_URL=postgresql://user:password@host:5432/cynthia_studio
# SQLite for local dev (no DB migrations needed with LOCAL_DEV_AUTH=true):
DATABASE_URL=file:./dev.db

# ─── Storage ──────────────────────────────────────────────────────────────────
STORAGE_ROOT=./apps/api/storage
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ─── FREE MODE — NVIDIA NIM Proxy ─────────────────────────────────────────────
# Routes text generation, prompt compilation, storyboards, and eval for free.
# Set NVIDIA_NIM_PROXY_BASE_URL and NVIDIA_NIM_PROXY_API_KEY in your .env.local.
# DO NOT commit real values to git.
NVIDIA_NIM_PROXY_ENABLED=false
NVIDIA_NIM_PROXY_BASE_URL=
NVIDIA_NIM_PROXY_API_KEY=
NVIDIA_NIM_PROXY_MODEL=moonshotai/kimi-k2-thinking
NVIDIA_NIM_PROXY_RPM=40
NVIDIA_NIM_PROXY_TIMEOUT_MS=120000

# ─── AI Providers (BYOK) ──────────────────────────────────────────────────────
# All keys are server-side only — never exposed to the browser.
OPENAI_API_KEY=
# OPENAI_BASE_URL=   # Override for custom endpoints (e.g. proxy). Do not commit real URLs.

FAL_ENABLED=false
FAL_KEY=
FAL_MAX_COST_PER_JOB_USD=1.00

MUAPI_ENABLED=false
MUAPI_KEY=

HF_ENABLED=false
HF_TOKEN=

COMFYUI_ENABLED=false
COMFYUI_BASE_URL=http://localhost:8188

LTX_ENABLED=false
LTX_WORKER_BASE_URL=http://localhost:8101

# Cynthia Gateway (enterprise)
# CYNTHIA_GATEWAY_URL=
# CYNTHIA_GATEWAY_API_KEY=

# ─── Job Worker ───────────────────────────────────────────────────────────────
# Secret for POST /api/v1/worker (Vercel Cron or external scheduler)
# Generate: openssl rand -hex 32
# WORKER_SECRET=

# Timeout per job in milliseconds (default 120000 = 2 minutes)
JOB_TIMEOUT_MS=120000

# fal.ai image/video generation
FAL_API_KEY=
# FAL_ENDPOINT=https://queue.fal.run
# FAL_IMAGE_MODEL=fal-ai/flux/schnell
# FAL_VIDEO_MODEL=fal-ai/fast-svd

# MuAPI generation
MUAPI_API_KEY=
# MUAPI_ENDPOINT=https://api.muapi.ai/v1

# ─── Queue / Redis ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Security ─────────────────────────────────────────────────────────────────
# Encryption key for BYOK credential vault (32 bytes hex)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CREDENTIAL_ENCRYPTION_KEY=

# ─── Observability ────────────────────────────────────────────────────────────
LOG_LEVEL=info
