# More-of-Less — API server only
# Use this when deploying the frontend to Vercel and the API separately
# (Railway service, Render, Fly.io, or any VPS)
FROM node:20-alpine

WORKDIR /app

RUN apk add --no-cache ffmpeg tini && \
    addgroup -S mol && adduser -S mol -G mol

ENV NODE_ENV=production \
    API_PORT=8000 \
    STORAGE_ROOT=/app/storage \
    DATABASE_URL=file:/app/data/mol.db

COPY apps/api/package.json ./
COPY apps/api/src ./src

RUN mkdir -p /app/storage /app/data && chown -R mol:mol /app

USER mol

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
  CMD wget -qO- http://localhost:8000/v1/health || exit 1

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "src/index.js"]
