# ─── More-of-Less — Production Environment ───────────────────────────────────
# Copy this to .env.production and fill in your values.
# NEVER commit your real .env.production to git.

# ─── Frontend (Next.js) ──────────────────────────────────────────────────────
# URL where the API server is reachable FROM THE BROWSER
NEXT_PUBLIC_API_BASE_URL=https://api.your-domain.com

# White-label brand (optional — defaults shown)
NEXT_PUBLIC_BRAND_NAME=More-of-Less
NEXT_PUBLIC_BRAND_TAGLINE=AI Creative Studio
NEXT_PUBLIC_BRAND_DESCRIPTION=AI audio/video studio for creators
NEXT_PUBLIC_BRAND_ACCENT=violet

# ─── API Server ───────────────────────────────────────────────────────────────
NODE_ENV=production
API_PORT=8000
PORT=3000

# Storage — where uploaded files and job outputs are saved
STORAGE_ROOT=/app/storage

# SQLite (default) — swap for postgres:// for production clusters
DATABASE_URL=file:/app/data/mol.db

# ─── AI Providers ─────────────────────────────────────────────────────────────
# All keys stay on the server — never exposed to the browser.

# Hugging Face Inference API (free tier available)
HF_ENABLED=false
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# fal.ai (pay-per-use video generation)
FAL_ENABLED=false
FAL_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FAL_MAX_COST_PER_JOB_USD=1.00

# Muapi (image + video + lip-sync)
MUAPI_ENABLED=false
MUAPI_KEY=

# Local workers (self-hosted)
COMFYUI_ENABLED=false
COMFYUI_BASE_URL=http://comfyui:8188
LTX_ENABLED=false
LTX_WORKER_BASE_URL=http://ltx-worker:8101

# ─── Optional ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379
LOG_LEVEL=info
