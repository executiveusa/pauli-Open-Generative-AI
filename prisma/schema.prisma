// Cynthia Studio — Production Multi-Tenant Schema
// Prisma ORM — PostgreSQL (set DATABASE_URL in env)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ─────────────────────────────────────────────────────────────────

enum Role {
  owner
  admin
  producer
  editor
  reviewer
  client
  viewer
}

enum JobStatus {
  draft
  queued
  running
  waiting_for_provider
  rendering
  evaluating
  succeeded
  failed
  cancelled
  needs_key
  needs_video_provider
  blocked_by_rights
  blocked_by_safety
}

enum JobType {
  hero_frame
  scene
  video
  lipsync
  storyboard
  evaluation
  prompt_compile
  music_video
  visualizer
  mix_master
}

enum ArtifactType {
  prompt
  image
  video
  audio
  subtitle
  storyboard
  inspection
  evaluation
  json
  reference
}

enum ConsentStatus {
  owned
  licensed
  consented
  unknown
  revoked
  pending
}

enum CredentialType {
  api_key
  oauth
  byok
  service_token
}

enum CredentialStatus {
  active
  inactive
  failed
  unknown
}

enum RoutingMode {
  auto_best
  free_mode
  fast_draft
  cheapest
  highest_quality
  best_character_consistency
  best_latam_output
  byok_only
  cynthia_gateway
  local_only
  compare
}

enum SafetyFlag {
  minor
  political_likeness
  explicit_content
  contested_ip
  requires_consent
}

enum AuditAction {
  create
  update
  delete
  login
  logout
  invite
  revoke
  generate
  approve
  reject
  export
}

// ─── Identity ──────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  image         String?
  emailVerified DateTime?
  locale        String   @default("en")
  timezone      String   @default("UTC")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  // Auth.js / NextAuth relations
  accounts      Account[]
  sessions      Session[]

  memberships   Membership[]
  ownedOrgs     Organization[]   @relation("OrgOwner")
  createdProjects Project[]      @relation("ProjectCreator")
  auditEvents   AuditEvent[]     @relation("AuditActor")
  createdJobs   GenerationJob[]  @relation("JobCreator")
  createdCharacters CharacterPassport[] @relation("CharacterCreator")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Tenancy ───────────────────────────────────────────────────────────────

model Organization {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  displayName String?
  logoUrl     String?
  country     String   @default("US")
  locale      String   @default("en")
  timezone    String   @default("UTC")
  plan        String   @default("free")
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  owner         User           @relation("OrgOwner", fields: [ownerId], references: [id])
  memberships   Membership[]
  workspaces    Workspace[]
  brandKits     BrandKit[]
  projects      Project[]
  credentials   ProviderCredential[]
  usageLedger   UsageLedger[]
  billingAccount BillingAccount?
  auditEvents   AuditEvent[]
  webhookEvents WebhookEvent[]

  @@index([ownerId])
}

model Workspace {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  slug           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id])
  memberships  Membership[]
  projects     Project[]
  characters   CharacterPassport[]

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  workspaceId    String?
  role           Role     @default(viewer)
  invitedAt      DateTime?
  acceptedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?   @relation(fields: [workspaceId], references: [id])

  @@unique([userId, organizationId, workspaceId])
  @@index([userId])
  @@index([organizationId])
}

// ─── Brand ─────────────────────────────────────────────────────────────────

model BrandKit {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  accentColor    String   @default("#7c3aed")
  logoUrl        String?
  fontPrimary    String?
  fontDisplay    String?
  voiceTone      String?
  styleGuide     Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  projects     Project[]

  @@index([organizationId])
}

// ─── Projects ──────────────────────────────────────────────────────────────

model Project {
  id             String   @id @default(cuid())
  organizationId String
  workspaceId    String?
  brandKitId     String?
  name           String
  description    String?
  clientName     String?
  locale         String   @default("en")
  status         String   @default("active")
  createdByUserId String
  updatedByUserId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization  Organization      @relation(fields: [organizationId], references: [id])
  workspace     Workspace?        @relation(fields: [workspaceId], references: [id])
  brandKit      BrandKit?         @relation(fields: [brandKitId], references: [id])
  createdBy     User              @relation("ProjectCreator", fields: [createdByUserId], references: [id])
  characters    CharacterPassport[]
  storyboards   Storyboard[]
  assets        Asset[]
  jobs          GenerationJob[]

  @@index([organizationId])
  @@index([workspaceId])
}

// ─── Characters ────────────────────────────────────────────────────────────

model CharacterPassport {
  id             String        @id @default(cuid())
  organizationId String
  workspaceId    String?
  projectId      String?
  createdByUserId String
  updatedByUserId String?

  displayName    String
  internalName   String?
  locale         String        @default("en")
  country        String?
  ageBand        String?
  archetype      String?

  faceSignature  String?
  bodySignature  String?
  hair           String?
  skinTone       String?
  wardrobeCore   String?
  accessories    String[]      @default([])
  personality    String?
  backstory      String?
  speechRegister String?
  dialect        String?
  voiceProfile   Json?

  promptAnchor         String   @default("")
  negativePromptAnchor String   @default("")
  triggerWords         String[] @default([])
  loras                Json?
  seedPolicy           Json?
  continuityRules      Json?

  canonicalHeroFrameArtifactId String?
  referenceAssets              Json?

  allowedUses                String[] @default([])
  consentStatus              ConsentStatus @default(unknown)
  commercialUseAllowed       Boolean  @default(false)
  likenessTrainingAllowed    Boolean  @default(false)
  voiceCloningAllowed        Boolean  @default(false)
  minorFlag                  Boolean  @default(false)
  politicalLikenessFlag      Boolean  @default(false)
  safetyFlags                SafetyFlag[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  organization    Organization    @relation(fields: [organizationId], references: [id])
  workspace       Workspace?      @relation(fields: [workspaceId], references: [id])
  project         Project?        @relation(fields: [projectId], references: [id])
  createdBy       User            @relation("CharacterCreator", fields: [createdByUserId], references: [id])
  consentRecords  ConsentRecord[]
  jobs            GenerationJob[]
  shots           Shot[]

  @@index([organizationId])
  @@index([projectId])
}

model ConsentRecord {
  id                  String        @id @default(cuid())
  characterPassportId String
  organizationId      String
  identityConsent     Boolean       @default(false)
  voiceConsent        Boolean       @default(false)
  commercialLicense   Boolean       @default(false)
  trainingAllowed     Boolean       @default(false)
  expiration          DateTime?
  revocationContact   String?
  sourceNotes         String?
  fileAttachments     String[]      @default([])
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  character CharacterPassport @relation(fields: [characterPassportId], references: [id])

  @@index([characterPassportId])
  @@index([organizationId])
}

// ─── Storyboards & Shots ───────────────────────────────────────────────────

model Storyboard {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String
  title          String
  description    String?
  status         String   @default("draft")
  aspectRatio    String   @default("16:9")
  durationSeconds Int?
  locale         String   @default("en")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  project Project @relation(fields: [projectId], references: [id])
  shots   Shot[]

  @@index([organizationId])
  @@index([projectId])
}

model Shot {
  id                  String   @id @default(cuid())
  storyboardId        String
  organizationId      String
  characterPassportId String?
  order               Int
  title               String?
  durationSeconds     Float?
  cameraPreset        String?
  motionPreset        String?
  promptEn            String   @default("")
  promptEs            String   @default("")
  negativePrompt      String   @default("")
  locationNotes       String?
  dialogueNotes       String?
  soundNotes          String?
  parameters          Json?
  heroArtifactId      String?
  status              String   @default("draft")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  storyboard Storyboard         @relation(fields: [storyboardId], references: [id])
  character  CharacterPassport? @relation(fields: [characterPassportId], references: [id])
  jobs       GenerationJob[]

  @@index([storyboardId])
  @@index([organizationId])
}

// ─── Assets & Artifacts ────────────────────────────────────────────────────

model Asset {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String?
  name           String
  kind           String
  url            String?
  storagePath    String?
  mimeType       String?
  sizeBytes      BigInt?
  durationMs     Int?
  provenance     String   @default("user-upload")
  rightsStatus   String   @default("unknown")
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  project Project? @relation(fields: [projectId], references: [id])

  @@index([organizationId])
  @@index([projectId])
}

model Artifact {
  id             String       @id @default(cuid())
  organizationId String
  jobId          String?
  type           ArtifactType
  url            String?
  storagePath    String?
  mimeType       String?
  sizeBytes      BigInt?
  durationMs     Int?
  metadata       Json?
  isFinal        Boolean      @default(false)
  createdAt      DateTime     @default(now())

  job GenerationJob? @relation(fields: [jobId], references: [id])

  @@index([organizationId])
  @@index([jobId])
}

// ─── Jobs ──────────────────────────────────────────────────────────────────

model GenerationJob {
  id             String    @id @default(cuid())
  organizationId String
  workspaceId    String?
  projectId      String?
  shotId         String?
  characterPassportId String?
  createdByUserId String

  jobType        JobType
  status         JobStatus  @default(draft)

  inputPrompt          String   @default("")
  inputNegativePrompt  String   @default("")
  inputSpanishPrompt   String   @default("")
  compiledPrompt       String?
  compiledNegativePrompt String?

  routingMode    RoutingMode @default(auto_best)
  providerId     String?
  modelId        String?
  providerJobId  String?
  routeDecision  Json?

  parameters     Json?
  costEstimate   Float?
  actualCost     Float?
  usageUnits     Json?

  evalResult     Json?
  failureReason  String?
  retryCount     Int      @default(0)
  maxRetries     Int      @default(3)

  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project   Project?           @relation(fields: [projectId], references: [id])
  shot      Shot?              @relation(fields: [shotId], references: [id])
  character CharacterPassport? @relation(fields: [characterPassportId], references: [id])
  createdBy User               @relation("JobCreator", fields: [createdByUserId], references: [id])
  artifacts Artifact[]

  @@index([organizationId])
  @@index([projectId])
  @@index([status])
  @@index([createdByUserId])
}

// ─── Provider Credentials ──────────────────────────────────────────────────

model ProviderCredential {
  id             String           @id @default(cuid())
  organizationId String
  providerId     String
  displayName    String
  credentialType CredentialType
  encryptedSecretRef String?
  status         CredentialStatus @default(unknown)
  lastTestedAt   DateTime?
  lastUsedAt     DateTime?
  scopes         String[]         @default([])
  capabilities   String[]         @default([])
  metadata       Json?
  createdByUserId String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, providerId])
  @@index([organizationId])
}

model ProviderRoute {
  id             String   @id @default(cuid())
  organizationId String
  routingMode    String
  primaryProvider String
  fallbackChain  String[] @default([])
  rules          Json?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
}

// ─── Billing & Usage ───────────────────────────────────────────────────────

model BillingAccount {
  id             String   @id @default(cuid())
  organizationId String   @unique
  plan           String   @default("free")
  monthlyBudgetUsd Float  @default(0)
  currentUsageUsd  Float  @default(0)
  billingEmail   String?
  stripeCustomerId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
}

model UsageLedger {
  id             String   @id @default(cuid())
  organizationId String
  providerId     String
  modelId        String?
  jobId          String?
  units          Float    @default(0)
  estimatedCost  Float    @default(0)
  actualCost     Float    @default(0)
  mode           String   @default("auto")
  periodMonth    String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([periodMonth])
}

// ─── Safety & Audit ────────────────────────────────────────────────────────

model SafetyReview {
  id             String   @id @default(cuid())
  organizationId String
  jobId          String?
  resourceType   String
  resourceId     String
  flags          SafetyFlag[] @default([])
  blocked        Boolean  @default(false)
  blockReason    String?
  reviewedByUserId String?
  reviewedAt     DateTime?
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([resourceId])
}

model EvaluationResult {
  id             String   @id @default(cuid())
  organizationId String
  jobId          String
  evaluatorType  String   @default("ai")
  score          Float?
  passedChecks   String[] @default([])
  failedChecks   String[] @default([])
  notes          String?
  rawResult      Json?
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([jobId])
}

model AuditEvent {
  id             String      @id @default(cuid())
  organizationId String
  actorId        String?
  action         AuditAction
  resourceType   String
  resourceId     String?
  beforeSnapshot Json?
  afterSnapshot  Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime    @default(now())

  actor        User?        @relation("AuditActor", fields: [actorId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([actorId])
  @@index([createdAt])
}

model WebhookEvent {
  id             String   @id @default(cuid())
  organizationId String
  source         String
  eventType      String
  payload        Json
  processed      Boolean  @default(false)
  processedAt    DateTime?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([processed])
}

model BrowserInspection {
  id             String   @id @default(cuid())
  organizationId String?
  url            String
  snapshotPath   String?
  screenshotPath String?
  consoleErrors  Json?
  networkFailures Json?
  vitals         Json?
  markdownReport String?
  baselineId     String?
  diffReport     Json?
  createdAt      DateTime @default(now())

  @@index([organizationId])
}
